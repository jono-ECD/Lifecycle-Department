# Database. SQLite by default. For Postgres see DEPLOY.md.
DATABASE_URL="file:./dev.db"

# Session cookie encryption. Use a random string of at least 32 characters in production.
SESSION_SECRET="change-me-to-a-random-string-of-at-least-32-characters"

# First admin account, created by `npm run seed`.
ADMIN_EMAIL="mauricio@ecdigitalstrategy.com"
ADMIN_PASSWORD="campaign-bank"
ADMIN_NAME="Mauricio"

# Public URL of the app, used in reviewer links and emails.
APP_URL="http://localhost:3000"

# File storage: "local" (default, ./storage) or "s3".
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
# S3_BUCKET=""
# S3_REGION="us-east-1"
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL=""

# Email. Without RESEND_API_KEY emails are printed to the console and still logged.
# RESEND_API_KEY=""
MAIL_FROM="bank@ecdigitalstrategy.com"

# Protects /api/cron/reminders. Send it as ?secret= or Authorization: Bearer.
CRON_SECRET="change-me"
# Set to 1 to run the daily reminder scheduler inside the app process.
RUN_SCHEDULER="0"
# How long to wait before emailing reviewers about campaigns moved to review, so several moves become one email.
REVIEW_BATCH_MS="600000"

NEXT_TELEMETRY_DISABLED=1
CHECKPOINT_DISABLE=1

# Fixed reviewer token for local development so the link in PROGRESS.md keeps working. Remove in production; regenerate links from the admin panel.
SEED_REVIEWER_TOKEN="bb-dev-reviewer-token-8f3a1c9d2e7b4a6f"

# Send step provider. Only "manual" exists today; see lib/sendProvider.ts.
SEND_PROVIDER="manual"
