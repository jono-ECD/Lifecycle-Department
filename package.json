{
  "name": "campaign-bank",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-env.mjs && next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "postinstall": "prisma generate",
    "db:push": "node scripts/ensure-env.mjs && prisma db push --skip-generate",
    "seed": "node scripts/ensure-env.mjs && prisma db push --skip-generate && tsx prisma/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/pw.mjs test",
    "e2e:install": "node scripts/pw.mjs install chromium",
    "check": "npm run lint && npm run typecheck && npm run test && npm run e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "iron-session": "^9.0.1",
    "next": "^15.5.26",
    "pdf-to-img": "^4.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
